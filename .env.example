# Copy to .env and fill in.

# Gemini (https://aistudio.google.com/apikey) — required for generation only.
# Crawl / chunk / embed / retrieve all work without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Vector store: "local" = embedded on-disk Qdrant (no Docker)
#               "server" = Qdrant container at QDRANT_URL
QDRANT_MODE=local
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=iitk_documents_v1

# Retrieval
TOP_K=6

# Docker Compose only: host port for the app (container always listens on 8000).
APP_PORT=8000
